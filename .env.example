# Port Server
PORT=5001

# JWT Secret untuk Autentikasi
JWT_SECRET=your_jwt_secret_key_here

# Database SQLite
DATABASE_PATH=./database/gradia.db

# Google Gemini AI (Opsional / untuk AI feedback)
GEMINI_API_KEY=your_gemini_api_key_here

# Vercel Blob Storage Token (Wajib untuk penyimpanan file & attachment)
# Dapatkan di Vercel Dashboard -> Storage -> Blob -> Settings/Quickstart
BLOB_READ_WRITE_TOKEN=vercel_blob_rw_xxxxxxxxxxxxxxxxxxxxxxxxxx
